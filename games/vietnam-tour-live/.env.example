# Cổng chạy Game Server (Mặc định: 3000)
PORT=3000

# Tên tài khoản TikTok Live đang phát sóng (ví dụ: @streamer_vietnam hoặc streamer_vietnam)
TIKTOK_USERNAME=@your_tiktok_username

# TikTok Session ID (Tùy chọn, dùng khi cần vượt captcha/xác thực TikTok)
TIKTOK_SESSION_ID=

# Tham số tùy chỉnh Thống kê hiển thị trên màn hình
TOTAL_VIEWERS_START=0
FOLLOWERS_START=0
FOLLOWERS_TARGET=10000

# Cấu hình RTMP cho Live Ngầm Colab (Chế độ Mode B)
TIKTOK_STREAM_URL=rtmp://live-push.tiktok.com/live/
TIKTOK_STREAM_KEY=

