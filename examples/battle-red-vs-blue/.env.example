# Cấu hình cổng chạy Server (Mặc định: 3000)
PORT=3000

# Tên tài khoản TikTok của bạn (có dấu @ hoặc không)
TIKTOK_USERNAME=@your_tiktok_username

# TikTok Session ID (Tùy chọn, dùng khi cần vượt xác thực)
TIKTOK_SESSION_ID=

# Cấu hình RTMP Live ngầm
TIKTOK_STREAM_URL=rtmp://live-push.tiktok.com/live/
TIKTOK_STREAM_KEY=
